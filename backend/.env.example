PROJECT_NAME="ViziCheck"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (MySQL)
DATABASE_URL="mysql+pymysql://root:@localhost:3306/vizicheck"

# JWT Token configuration
JWT_SECRET="generate-a-strong-jwt-secret-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# CORS Origins (comma-separated list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"
